<o:Table Id="o14">
<a:ObjectID>DC14CEDB-EBD2-4616-BA02-A19A3D069BE3</a:ObjectID>
<a:Name>v1_post</a:Name>
<a:Code>v1_post</a:Code>
<a:CreationDate>1422479118</a:CreationDate>
<a:Creator>oleg</a:Creator>
<a:ModificationDate>1773860864</a:ModificationDate>
<a:Modifier>olegs</a:Modifier>
<a:EndScript>ALTER TABLE v1_post 
ADD COLUMN search_vector tsvector 
    GENERATED ALWAYS AS 
    (to_tsvector(&#39;russian&#39;, searchable_content) || 
     to_tsvector(&#39;english&#39;, searchable_content) || 
     to_tsvector(&#39;german&#39;, searchable_content)) STORED;


CREATE INDEX v1_post_ftx ON v1_post USING GIN (search_vector);
</a:EndScript>
<a:TotalSavingCurrency/>
